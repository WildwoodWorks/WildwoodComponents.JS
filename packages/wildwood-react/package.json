{
  "name": "@wildwood/react",
  "version": "0.1.0",
  "description": "Wildwood React components, hooks, and provider for WildwoodAPI integration",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    },
    "./styles": "./dist/wildwood-themes.css",
    "./dist/wildwood-themes.css": "./dist/wildwood-themes.css"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@wildwood/react-shared": "workspace:*",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "storybook": "^10.6.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@playwright/test": "1.65.1",
    "@wildwood/core": "workspace:*",
    "@wildwood/react-shared": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "keywords": [
    "wildwood",
    "react",
    "hooks",
    "components",
    "authentication",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wildwood-platform/wildwood-js.git",
    "directory": "packages/wildwood-react"
  },
  "homepage": "https://github.com/wildwood-platform/wildwood-js/tree/master/packages/wildwood-react#readme",
  "bugs": {
    "url": "https://github.com/wildwood-platform/wildwood-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "html2canvas": "^1.4.1"
  }
}
