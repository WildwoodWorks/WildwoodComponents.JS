{
  "name": "wildwood-js",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm --filter @wildwood/core --filter @wildwood/react run test:coverage",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r exec rm -rf dist",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "docs": "typedoc",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --config playwright.ci.config.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:csp": "playwright test --config playwright.csp.config.ts",
    "size": "node scripts/size-report.mjs",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'packages/*/src/**/*.{ts,tsx}'",
    "eslint": "eslint 'packages/*/src/**/*.{ts,tsx}'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@wildwood/react": "workspace:*",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typedoc": "^0.28.20",
    "typescript-eslint": "^8.73.0"
  }
}
